{
  "name": "aioplugins",
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "private": false,
  "description": "Create personalized Nuvio plugin repositories from selected GitHub sources.",
  "type": "module",
  "scripts": {
    "build:site": "astro build",
    "build:worker": "tsc -p tsconfig.json",
    "build": "npm run build:site && npm run build:worker",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "predev": "npm run build:site",
    "dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.5",
    "astro": "^7.4.4",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
