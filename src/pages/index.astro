---
import AccountSettings from '../components/AccountSettings.astro';
import AboutPage from '../components/AboutPage.astro';
import SupportPage from '../components/SupportPage.astro';
import AuthView from '../components/AuthView.astro';
import MiddlewareSettings from '../components/MiddlewareSettings.astro';
import PluginSetup from '../components/PluginSetup.astro';
import ReviewInstall from '../components/ReviewInstall.astro';
import Sidebar from '../components/Sidebar.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>AIOPlugins</title>
  <link rel="stylesheet" href="/index.css">
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png">
  <meta name="theme-color" content="#050A1C">
</head>
<body>
  <main class="shell">
    <AuthView />

    <!-- Main application -->
    <div id="app-view" hidden>
      <div class="app-layout">

        <Sidebar />

        <!-- MAIN CONTENT -->
        <div class="app-main">

          <section class="intro">
            <div class="intro-copy">
              <h2 id="page-title">Choose your plugins</h2>
              <p id="page-description">Select plugin sources and choose the providers you want to use.</p>
            </div>
            <div class="intro-actions">
              <span id="quick-save-status" class="quick-save-feedback" role="status" aria-live="polite"></span>
              <div id="session-bar" class="session-bar" hidden>
                <button id="support-shortcut" class="button button-small header-icon-button support-header-button" type="button"
                  aria-label="Support the project" title="Support the project">
                  <i data-lucide="heart-handshake" aria-hidden="true"></i>
                </button>
                <button id="quick-save" class="button button-small header-icon-button" type="button"
                  aria-label="Quick save" title="Quick save" disabled>
                  <i data-lucide="save" aria-hidden="true"></i>
                </button>
                <button id="account-menu" class="button button-small header-icon-button" type="button"
                  aria-label="Account" title="Account">
                  <i data-lucide="user-round" aria-hidden="true"></i>
                </button>
                <button id="logout" class="button button-small header-icon-button" type="button"
                  aria-label="Log out" title="Log out">
                  <i data-lucide="log-out" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </section>

          <PluginSetup />
          <MiddlewareSettings />
          <ReviewInstall />
          <AccountSettings />
          <AboutPage />
          <SupportPage />

        </div>
      </div>
    </div>

  </main>

  <script src="../scripts/app.ts"></script>
</body>
</html>