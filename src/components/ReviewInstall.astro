---
import ManifestPanel from './ManifestPanel.astro';
import ProfilesPanel from './ProfilesPanel.astro';
---
          <!-- STEP 2: Review and install -->
          <section id="save-view" class="view" hidden>


            <section class="panel save-card" aria-labelledby="review-heading">
              <div class="panel-head">
                <div>
                  <h2 id="review-heading">Your selection</h2>
                  <p class="panel-subtitle">These plugins and your filter, sorting, and formatter settings will be saved together.</p>
                </div>
                <span id="review-count" class="source-summary">0 plugins</span>
              </div>

              <div id="review-selection" class="review-selection">
                <p class="view-intro">No plugins selected yet.</p>
              </div>

              <div class="panel-body review-footer">
                <button id="edit-selection" class="button button-small" type="button">
                  Edit selection
                </button>
              </div>
            </section>

            <section class="panel save-card" aria-labelledby="save-heading">
              <div class="panel-head">
                <div>
                  <h2 id="save-heading">Save &amp; Install</h2>
                  <p class="panel-subtitle">Save your selected plugins and all filter, sorting, and formatter settings together.</p>
                </div>
              </div>

              <div class="panel-body">
                <p id="save-status" class="status" role="status" aria-live="polite"></p>
                <button id="apply" class="button button-primary button-wide" type="button" disabled>
                  Save &amp; Install
                </button>
              </div>
            </section>

            <section class="panel output-panel" aria-labelledby="output-heading">
              <div class="panel-head output-head">
                <div>
                  <h2 id="output-heading">Install in Nuvio</h2>
                  <p class="panel-subtitle">Your personal plugin repository link.</p>
                </div>
                <span id="output-state" class="output-state">Not saved yet</span>
              </div>

              <div class="output-body">
                <div>
                  <p class="output-label">Your private plugin repository URL</p>

                  <div class="copy-row">
                    <button id="plugin-url" class="addon-url" type="button"
                      title="Copy plugin repository URL">
                      Choose Save &amp; Install to generate your link.
                    </button>

                    <button id="copy-plugin-url" class="button" type="button" disabled>
                      Copy URL
                    </button>
                  </div>

                  <p id="copy-feedback" class="output-hint" aria-live="polite">
                    After saving, copy this link and paste it into Nuvio's plugin source settings.
                    Treat it like a password: anyone with it can load your plugin list.
                  </p>
                </div>

                <div class="install-instructions">
                  <h3>How to install</h3>
                  <ol>
                    <li>Choose <strong>Save &amp; Install</strong> to save your plugins and middleware settings together.</li>
                    <li>Copy your private repository URL.</li>
                    <li>Open Nuvio and go to its plugin source settings.</li>
                    <li>Add your copied URL as a plugin source.</li>
                  </ol>
                </div>
              </div>
            </section>

            <ProfilesPanel />

            <ManifestPanel />

          </section>
