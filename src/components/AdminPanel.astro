---
import CatalogPanel from './CatalogPanel.astro';
import SourcePanel from './SourcePanel.astro';
import FilterPanel from './middleware/FilterPanel.astro';
import FormatterPanel from './middleware/FormatterPanel.astro';
import SortPanel from './middleware/SortPanel.astro';
---
<!-- Admin: the curated plugin list everyone can subscribe to. Every tab is the same
     component the account uses (plugins, filters, sorting, formatter) with its own
     element ids, plus a Publish tab that mirrors Save & Install. -->
<section id="admin-view" class="view" hidden>
  <div class="workspace" data-tab="plugins">
    <SourcePanel prefix="admin-">
      <div class="quick-source-section">
        <label>Curated list</label>
        <div class="quick-sources">
          <button id="admin-reload" class="button button-small" type="button"
            title="Look up the newest commit of every source">Reload sources</button>
          <button id="admin-import" class="button button-small" type="button"
            title="Replace this selection and its settings with an exported backup file">Import backup</button>
          <input id="admin-import-file" type="file" accept="application/json,.json" hidden>
        </div>
        <p class="field-hint">Importing a backup replaces the selection and the filter, sorting and formatter settings. Review them, then publish.</p>
      </div>
    </SourcePanel>
    <CatalogPanel prefix="admin-" continueLabel="Continue to publish →" />
  </div>

  <FilterPanel prefix="admin-" />
  <SortPanel prefix="admin-" />
  <FormatterPanel prefix="admin-" />

  <section class="panel save-card" data-tab="publish" aria-labelledby="admin-publish-heading">
    <div class="panel-head">
      <div>
        <h2 id="admin-publish-heading">Publish</h2>
        <p class="panel-subtitle">Publish the selected plugins and all filter, sorting, and formatter settings together. Accounts following the curated list receive them immediately.</p>
      </div>
      <span id="admin-followers" class="source-summary"></span>
    </div>

    <div class="panel-body">
      <p id="admin-count" class="field-hint">No plugins selected</p>
      <p id="admin-publish-status" class="status" role="status" aria-live="polite"></p>
      <button id="admin-publish" class="button button-primary button-wide" type="button" disabled>
        Publish for everyone
      </button>
    </div>
  </section>
</section>
