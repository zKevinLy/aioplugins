<!-- Follow the admins' curated plugin list -->
<section class="panel curated-card" aria-labelledby="curated-heading">
  <div class="panel-head">
    <div>
      <h2 id="curated-heading">Curated plugins</h2>
      <p class="panel-subtitle">A ready-made selection kept up to date for you.</p>
    </div>
    <span id="curated-state" class="source-summary"></span>
  </div>

  <div class="panel-body">
    <label class="curated-toggle">
      <input id="curated-follow" type="checkbox" disabled>
      <span>
        <strong>Subscribe to the curated plugins</strong>
        <span id="curated-detail" class="field-hint"></span>
      </span>
    </label>

    <p id="curated-status" class="status" role="status" aria-live="polite"></p>
  </div>
</section>
