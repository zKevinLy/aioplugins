---
import FilterPanel from './middleware/FilterPanel.astro';
import FormatterPanel from './middleware/FormatterPanel.astro';
import SortPanel from './middleware/SortPanel.astro';
---
          <!-- Stream middleware settings -->
          <section id="middleware-view" class="view" hidden>

            <FilterPanel />

            <SortPanel />

            <FormatterPanel />

            <p class="field-hint middleware-save-hint">Your filter, sorting, and formatter changes are kept together and included when you choose <strong>Save &amp; Install</strong>.</p>
          </section>
