---
const { prefix = "", continueLabel = "Continue to save →" } = Astro.props;
---
<!-- Plugin catalog -->
<section class="panel" aria-labelledby={`${prefix}catalog-heading`}>
  <div class="panel-head">
    <div>
      <h2 id={`${prefix}catalog-heading`}>Available plugins</h2>
      <p class="panel-subtitle">Select the providers you want to include.</p>
    </div>

    <div class="catalog-tools">
      <input id={`${prefix}search`} class="search" type="search"
        placeholder="Search plugins" aria-label="Search plugins">
      <select id={`${prefix}selection-filter`} class="filter-select" aria-label="Filter by selection">
        <option value="all">All plugins</option>
        <option value="selected">Selected</option>
        <option value="unselected">Not selected</option>
      </select>
      <button id={`${prefix}select-filtered`} class="button button-small" type="button"
        aria-controls={`${prefix}catalog`}
        title="Select all enabled plugins matching the search across all sources"
        disabled>
        Select all
      </button>
    </div>
  </div>

  <div id={`${prefix}catalog`} class="catalog-empty">
    <strong>Loading your plugin sources...</strong>
    <p>Your suggested sources will appear here automatically.</p>
  </div>

  <div class="actionbar">
    <span id={`${prefix}selection-count`} class="selection-count">No plugins selected</span>
    <button id={`${prefix}go-save`} class="button button-primary" type="button" disabled>
      {continueLabel}
    </button>
  </div>
</section>
