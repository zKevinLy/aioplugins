<section id="middleware-formatting" class="panel middleware-panel" aria-labelledby="formatter-heading" hidden>
  <div class="panel-head">
    <div>
      <h2 id="formatter-heading">Stream name and description</h2>
      <p class="panel-subtitle">Set the short stream label separately from its release details.</p>
    </div>
  </div>
  <div class="panel-body">
    <div class="formatter-layout">
      <div class="formatter-editor">
        <div class="field-row formatter-presets">
          <div class="field">
            <label for="format-preset">Description preset</label>
            <select id="format-preset">
              <option value="detailed">Detailed</option>
              <option value="compact">Compact</option>
              <option value="title">Title only</option>
            </select>
          </div>
          <div class="field formatter-action">
            <label aria-hidden="true">&nbsp;</label>
            <button id="apply-format-preset" class="button button-small" type="button">Use format</button>
          </div>
        </div>
        <div class="field-row formatter-insert">
          <div class="field">
            <label for="format-field">Insert stream field</label>
            <select id="format-field"></select>
          </div>
          <div class="field">
            <label for="format-target">Insert into</label>
            <select id="format-target">
              <option value="stream-name-format">Name</option>
              <option value="stream-description-format" selected>Description</option>
            </select>
          </div>
          <div class="field formatter-action">
            <label aria-hidden="true">&nbsp;</label>
            <button id="insert-format-field" class="button button-small" type="button">Insert token</button>
          </div>
        </div>
        <div class="field">
          <label for="stream-name-format">Name template</label>
          <textarea id="stream-name-format" rows="3" spellcheck="false"></textarea>
        </div>
        <div class="field">
          <label for="stream-description-format">Description template</label>
          <textarea id="stream-description-format" rows="12" spellcheck="false"></textarea>
          <p class="field-hint">AIOStreams formatter syntax is supported, including nested groups, conditions, and modifiers. Common release fields are inferred from provider filenames when possible; other fields need to be supplied by the provider.</p>
        </div>
      </div>

      <aside class="formatter-preview" aria-label="Formatter live preview">
        <div class="formatter-preview-heading">
          <h3>Live preview</h3>
          <span id="formatter-preview-state" class="formatter-preview-state">Waiting</span>
        </div>
        <div class="formatter-preview-output">
          <span class="formatter-preview-source">4KHDHub · 1080p</span>
          <div class="formatter-preview-line">
            <span class="formatter-preview-label">Name</span>
            <p id="formatter-preview-name" aria-live="polite">Rendering preview…</p>
          </div>
          <div class="formatter-preview-line">
            <span class="formatter-preview-label">Description</span>
            <p id="formatter-preview-description" aria-live="polite">Rendering preview…</p>
          </div>
        </div>

        <details class="formatter-sample-section" open>
          <summary>Parsed file data</summary>
          <div class="field">
            <label for="formatter-filename">Filename</label>
            <input id="formatter-filename" type="text" value="Movie.Title.2023.2160p.BluRay.HEVC.DV.TrueHD.Atmos.7.1.iTA.ENG-GROUP.mkv" spellcheck="false">
          </div>
          <pre id="formatter-parsed-fields" class="formatter-parsed-fields">Waiting for parsed fields…</pre>
        </details>

        <details class="formatter-sample-section">
          <summary>Stream data</summary>
          <label for="formatter-stream-data">Sample values</label>
          <textarea id="formatter-stream-data" rows="7" spellcheck="false">&#123;
  "type": "http",
  "cached": true,
  "size": 515100000,
  "duration": 7200000,
  "languages": ["Italian", "English"],
  "subtitles": ["English"],
  "seeders": 0
&#125;</textarea>
        </details>

        <details class="formatter-sample-section">
          <summary>Metadata</summary>
          <label for="formatter-metadata">Sample values</label>
          <textarea id="formatter-metadata" rows="6" spellcheck="false">&#123;
  "title": "Movie Title",
  "year": 2023,
  "type": "movie",
  "runtime": 130
&#125;</textarea>
        </details>
      </aside>
    </div>
  </div>
</section>
