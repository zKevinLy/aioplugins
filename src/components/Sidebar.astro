<!-- Primary application navigation -->
<aside class="sidebar" id="app-sidebar" aria-label="Application sidebar">
  <div class="sidebar-top">
    <span class="sidebar-brand">Navigation</span>
    <button id="sidebar-toggle" class="sidebar-toggle" type="button"
      aria-label="Collapse sidebar" aria-expanded="true" aria-controls="app-sidebar"
      title="Collapse sidebar">
      <i data-lucide="panel-left-close" aria-hidden="true"></i>
    </button>
  </div>

  <div class="sidebar-group">
    <p class="sidebar-heading">Configure</p>
    <nav class="sidebar-nav" aria-label="Configure">
      <button id="configure-tab" class="nav-item active" type="button" aria-current="page"
        title="Plugins" aria-label="Plugins">
        <i class="nav-icon" data-lucide="puzzle" aria-hidden="true"></i>
        <span class="nav-label">Plugins</span>
        <span class="nav-tag">1</span>
      </button>
      <button id="filters-tab" class="nav-item" type="button" title="Filters" aria-label="Filters">
        <i class="nav-icon" data-lucide="filter" aria-hidden="true"></i>
        <span class="nav-label">Filters</span>
        <span class="nav-tag">1</span>
      </button>
      <button id="sorting-tab" class="nav-item" type="button" title="Sorting" aria-label="Sorting">
        <i class="nav-icon" data-lucide="arrow-down-up" aria-hidden="true"></i>
        <span class="nav-label">Sorting</span>
        <span class="nav-tag">2</span>
      </button>
      <button id="formatting-tab" class="nav-item" type="button" title="Formatter" aria-label="Formatter">
        <i class="nav-icon" data-lucide="list-filter" aria-hidden="true"></i>
        <span class="nav-label">Formatter</span>
        <span class="nav-tag">3</span>
      </button>
      <button id="save-tab" class="nav-item" type="button" aria-current="false"
        title="Save & Install" aria-label="Save & Install">
        <i class="nav-icon" data-lucide="save" aria-hidden="true"></i>
        <span class="nav-label">Save &amp; Install</span>
        <span class="nav-tag">2</span>
      </button>
    </nav>
  </div>

  <div class="sidebar-divider"></div>

  <div class="sidebar-group">
    <p class="sidebar-heading">Preferences</p>
    <nav class="sidebar-nav" aria-label="Preferences">
      <button id="account-nav" class="nav-item" type="button"
        title="Account settings" aria-label="Account settings">
        <i class="nav-icon" data-lucide="settings-2" aria-hidden="true"></i>
        <span class="nav-label">Account settings</span>
      </button>
    </nav>
  </div>

  <div class="sidebar-divider"></div>

  <div class="sidebar-group">
    <p class="sidebar-heading">Support</p>
    <nav class="sidebar-nav" aria-label="Support">
      <button id="about-nav" class="nav-item" type="button" title="About" aria-label="About">
        <i class="nav-icon" data-lucide="info" aria-hidden="true"></i>
        <span class="nav-label">About</span>
      </button>
    </nav>
  </div>

  <a class="sidebar-sponsor" aria-label="Sponsor AIOPlugins" href="https://github.com/sponsors/zKevinLy"
    target="_blank" rel="noopener noreferrer" title="Sponsor AIOPlugins">
    <span class="sponsor-icon"><i data-lucide="heart" aria-hidden="true"></i></span>
    <span class="sponsor-copy">
      <strong>Support the project</strong>
      <small>Servers aren't free. Help keep it running.</small>
    </span>
    <i class="sponsor-arrow" data-lucide="external-link" aria-hidden="true"></i>
  </a>
</aside>
